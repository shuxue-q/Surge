#!name=同花顺去推荐广告
#!desc=2026-04-30更新-去除同花顺推荐广告
#!icon=https://raw.githubusercontent.com/shuxue-q/loon/main/icon/tonghuashun.png
#!category=Androidcn[https://github.com/androidcn]

[URL Rewrite]
#同花顺
^https?:\/\/adm\.10jqka\.com\.cn\/interface\/ad\/recommend - reject

[Map Local]
^https:\/\/c\.10jqka\.com\.cn\/lgt\/common2c\/auth\/api\/ad_recommend\/v1\/comment_ad_recommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
THSblockAD = type=http-response, pattern=^https:\/\/recommend\.10jqka\.com\.cn\/app\/discover\/api\/v1\/recommend, script-path=https://raw.githubusercontent.com/androidcn/userscripts/main/tonghuashun.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% recommend.10jqka.com.cn, c.10jqka.com.cn
